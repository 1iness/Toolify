@model IEnumerable<Toolify.ProductService.Models.Order>

@{
    ViewData["Title"] = "Управление заказами";
    Layout = "_AdminLayout";
}

<div class="orders-container py-2 px-1">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card mb-4 admin-panel-card border-0">
            <div class="card-body bg-light rounded-top">
                <form method="get" asp-action="Orders" class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label fw-bold text-muted small text-uppercase">Дата начала</label>
                        <input type="date" name="startDate" class="form-control" value="@ViewBag.StartDate" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold text-muted small text-uppercase">Дата окончания</label>
                        <input type="date" name="endDate" class="form-control" value="@ViewBag.EndDate" />
                    </div>
                    <div class="col-md-6">
                        <button type="submit" class="btn btn-primary me-2">Применить фильтр</button>
                        <a href="/Admin/Orders" class="btn btn-outline-secondary"><i class="fas fa-times me-1"></i> Сбросить</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="card admin-panel-card border-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th width="7%"></th>
                            <th width="8%">№ Заказа</th>
                            <th width="14%">Дата</th>
                            <th width="28%">Клиент</th>
                            <th width="11%">Сумма</th>
                            <th width="9%">Промокод</th>
                            <th width="16%">Статус</th>
                            <th width="7%" class="text-center">Состав</th>
                        </tr>
                    </thead>
                    <tbody id="orders-filter-tbody">
                        @if (Model != null && Model.Any())
                        {
                            foreach (var order in Model)
                            {
                                var guestFirst = order.GuestFirstName ?? "";
                                var guestLast = order.GuestLastName ?? "";
                                var guestMail = order.GuestEmail ?? "";
                                var orderSearchBlob = $"{guestFirst} {guestLast} {guestMail}".Trim().ToLowerInvariant();
                                var collapseId = $"order-lines-{order.Id}";
                                var items = order.Items ?? new List<OrderItem>();
                                <tr class="order-row-summary align-middle" data-order-search="@orderSearchBlob">
                                    <td class="text-muted" style="width:1%;white-space:nowrap;">
                                        <button type="button"
                                                class="btn btn-sm btn-link order-toggle px-1 py-0 text-decoration-none"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#@collapseId"
                                                aria-expanded="false"
                                                aria-controls="@collapseId"
                                                title="Показать или скрыть состав заказа">
                                            <i class="bi bi-chevron-down toggle-icon" aria-hidden="true"></i>
                                        </button>
                                    </td>
                                    <td class="fw-bold text-primary">#@order.Id</td>
                                    <td>@order.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>
                                        <div class="client-info">
                                            <div class="client-name">@(order.GuestFirstName ?? "Зарегистрированный") @order.GuestLastName</div>
                                            <div class="client-email">@order.GuestEmail</div>
                                            @if (!string.IsNullOrEmpty(order.GuestPhone))
                                            {
                                                <div class="small text-muted">@order.GuestPhone</div>
                                            }
                                        </div>
                                    </td>
                                    <td class="fw-bold">@order.TotalAmount.ToString("N2") <span class="nbrb-icon">&#xE901;</span></td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(order.PromoCode))
                                        {
                                            <span class="badge bg-success">@order.PromoCode</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @{
                                            var selSource = OrderStatusWorkflow.TryNormalize(order.Status, out var c) ? c : order.Status;
                                            var selClassRaw = selSource.Replace(" ", ".");
                                            var statusChoices = OrderStatusWorkflow.GetSelectOptions(order.Status);
                                            var terminal = OrderStatusWorkflow.IsTerminal(order.Status);
                                        }
                                        <form asp-action="UpdateOrderStatus" method="post" class="m-0">
                                            <input type="hidden" name="orderId" value="@order.Id" />
                                            <select name="status" class="form-select status-select status-@selClassRaw" @{
                                                if (terminal) { WriteLiteral(" disabled"); }
                                                else { WriteLiteral(@" onchange=""this.form.submit()"""); }
                                            }>
                                                @foreach (var opt in statusChoices)
                                                {
                                                    if (string.Equals(selSource, opt, StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <option value="@opt" selected>@opt</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@opt">@opt</option>
                                                    }
                                                }
                                            </select>
                                        </form>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge rounded-pill bg-light text-dark border" title="Позиций в заказе">@items.Count</span>
                                    </td>
                                </tr>
                                <tr class="order-row-detail border-0">
                                    <td colspan="8" class="p-0 border-0">
                                        <div id="@collapseId" class="collapse">
                                            <div class="order-lines-panel px-3 py-3 mx-2 mb-2">
                                                @if (!string.IsNullOrWhiteSpace(order.Address))
                                                {
                                                    <div class="order-detail-meta small text-muted mb-3">
                                                        <span class="text-uppercase fw-semibold text-secondary" style="font-size:0.7rem;">Адрес доставки</span><br />
                                                        <span class="text-dark">@order.Address</span>
                                                    </div>
                                                }
                                                @if (items.Count > 0)
                                                {
                                                    <div class="table-responsive mb-0">
                                                        <table class="table table-sm align-middle order-lines-inner mb-0">
                                                            <thead>
                                                                <tr>
                                                                    <th>#</th>
                                                                    <th>Товар</th>
                                                                    <th class="text-end text-nowrap">Кол-во</th>
                                                                    <th class="text-end text-nowrap">Цена за ед.</th>
                                                                    <th class="text-end text-nowrap">Сумма</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @{ var lineNo = 0; }
                                                                @foreach (var line in items)
                                                                {
                                                                    lineNo++;
                                                                    var name = !string.IsNullOrWhiteSpace(line.ProductName)
                                                                        ? line.ProductName!
                                                                        : $"Товар №{line.ProductId}";
                                                                    var lineTotal = line.Quantity * line.Price;
                                                                    <tr>
                                                                        <td class="text-muted small">@lineNo</td>
                                                                        <td>@name</td>
                                                                        <td class="text-end">@line.Quantity</td>
                                                                        <td class="text-end">@line.Price.ToString("N2") <span class="nbrb-icon small">&#xE901;</span></td>
                                                                        <td class="text-end fw-semibold">@lineTotal.ToString("N2") <span class="nbrb-icon small">&#xE901;</span></td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <p class="text-muted small mb-0">Состав заказа в базе не найден.</p>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="fas fa-box-open fa-3x mb-3 text-light"></i><br />
                                    В выбранном диапазоне дат заказы не найдены.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
</div>
