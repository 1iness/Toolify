@model IEnumerable<Toolify.AuthService.Models.User>

@{
    ViewData["Title"] = "Пользователи";
    Layout = "_AdminLayout";

    var users = Model?.ToList() ?? new List<Toolify.AuthService.Models.User>();
    var total = users.Count;
    var admins = users.Count(u => u.Role == "Admin");
    var blocked = users.Count(u => u.IsBlocked);
    var active = total - blocked;
    var hasUsers = users.Any();
}

<link rel="stylesheet" href="~/css/site.css" />

<div class="admin-flush-page" data-admin-heading="Клиенты">
    <h1 class="visually-hidden">Клиенты</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close js-dismiss-alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close js-dismiss-alert" aria-label="Close"></button>
        </div>
    }

    @if (!hasUsers)
    {
        <p class="text-muted text-center py-5 mb-0">Список пользователей пока пуст.</p>
    }
    else
    {
        <input id="userSearch" type="hidden" />

        <div id="admin-clients-filters" class="admin-products-filters mb-3">
            <div class="admin-products-filters__row row g-2 align-items-end">
                <div class="col-auto">
                    <span class="form-label small text-muted mb-0 d-block">Роль</span>
                    <select id="roleFilter" class="form-select form-select-sm">
                        <option value="">Все</option>
                        <option value="Admin">Admin</option>
                        <option value="User">User</option>
                    </select>
                </div>
                <div class="col-auto">
                    <span class="form-label small text-muted mb-0 d-block">Статус</span>
                    <select id="statusFilter" class="form-select form-select-sm">
                        <option value="">Все</option>
                        <option value="Active">Активен</option>
                        <option value="Blocked">Заблокирован</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="admin-clients-filter-reset">Сбросить фильтры</button>
                </div>
            </div>
            <p class="admin-clients-stats small text-muted mb-0 mt-2">
                Всего <strong>@total</strong> ·
                активные <strong class="text-success">@active</strong> ·
                заблокированные <strong class="text-danger">@blocked</strong> ·
                администраторы <strong>@admins</strong>
            </p>
        </div>

        <div class="admin-products-table-wrap">
            <table class="admin-table admin-table--products" id="usersTable">
                <thead>
                    <tr>
                        <th>Пользователь</th>
                        <th>Email</th>
                        <th>Телефон</th>
                        <th>Email подтверждён</th>
                        <th>Дата регистрации</th>
                        <th>Роль</th>
                        <th>Статус</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody id="clients-filter-tbody">
                    @foreach (var u in users)
                    {
                        var fullName = string.Concat(u.FirstName, " ", u.LastName).Trim();
                        var displayName = !string.IsNullOrWhiteSpace(fullName) ? fullName : "Без имени";
                        var statusKey = u.IsBlocked ? "Blocked" : "Active";
                        var createdAtText = u.CreatedAt?.ToString("dd.MM.yyyy HH:mm") ?? "—";

                        <tr class="client-row"
                            data-role="@u.Role"
                            data-status="@statusKey"
                            data-search="@($"{displayName} {u.Email} {u.Phone}")">
                            <td><strong>@displayName</strong></td>
                            <td class="text-nowrap">@u.Email</td>
                            <td class="clients-phone-cell">@(string.IsNullOrWhiteSpace(u.Phone) ? "—" : u.Phone)</td>
                            <td>
                                @if (u.EmailConfirmed)
                                {
                                    <span class="badge bg-success">Да</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Нет</span>
                                }
                            </td>
                            <td class="text-nowrap">@createdAtText</td>
                            <td>
                                @if (u.Role == "Admin")
                                {
                                    <span class="badge bg-primary">Admin</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">User</span>
                                }
                            </td>
                            <td>
                                @if (u.IsBlocked)
                                {
                                    <span class="badge bg-danger">Заблокирован</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Активен</span>
                                }
                            </td>
                            <td class="action-links">
                                <form asp-action="ChangeUserRole" method="post" style="display:inline;">
                                    <input type="hidden" name="userId" value="@u.Id" />
                                    <input type="hidden" name="role" value="@(u.Role == "Admin" ? "User" : "Admin")" />
                                    <button type="submit" class="btn btn-link p-0 align-baseline">
                                        @(u.Role == "Admin" ? "Снять Admin" : "Сделать Admin")
                                    </button>
                                </form>
                                |
                                <form asp-action="ToggleUserBlocked" method="post" style="display:inline;">
                                    <input type="hidden" name="userId" value="@u.Id" />
                                    <input type="hidden" name="isBlocked" value="@(u.IsBlocked ? "false" : "true")" />
                                    <button type="submit" class="btn btn-link p-0 align-baseline @(u.IsBlocked ? "" : "delete-link")">
                                        @(u.IsBlocked ? "Разблокировать" : "Заблокировать")
                                    </button>
                                </form>
                                |
                                <form asp-action="SendPasswordReset" method="post" style="display:inline;">
                                    <input type="hidden" name="email" value="@u.Email" />
                                    <button type="submit" class="btn btn-link p-0 align-baseline">Сброс пароля</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <p id="clientsNoResults" class="text-muted text-center py-4 mb-0 d-none">Ничего не найдено. Измените поиск или фильтры.</p>

        <div id="clients-pagination-wrap" class="products-load-more-wrap mt-3 d-none text-center">
            <div class="d-flex flex-wrap gap-2 justify-content-center mb-2">
                <button type="button" class="btn-create categories-load-action-btn d-none" id="clients-load-more-btn">Показать ещё</button>
                <button type="button" class="btn-create btn-create--secondary categories-load-action-btn d-none" id="clients-load-less-btn">Свернуть</button>
            </div>
            <p class="text-muted small mb-0" id="clients-pagination-info"></p>
        </div>
    }
</div>

<script>
    (function () {
        const PAGE_SIZE = 10;
        const searchInput = document.getElementById('userSearch');
        const roleFilter = document.getElementById('roleFilter');
        const statusFilter = document.getElementById('statusFilter');
        const resetBtn = document.getElementById('admin-clients-filter-reset');
        const rows = Array.from(document.querySelectorAll('.client-row'));
        const noResults = document.getElementById('clientsNoResults');
        const paginationWrap = document.getElementById('clients-pagination-wrap');
        const loadMoreBtn = document.getElementById('clients-load-more-btn');
        const loadLessBtn = document.getElementById('clients-load-less-btn');
        const paginationInfo = document.getElementById('clients-pagination-info');
        const tableWrap = document.querySelector('.admin-products-table-wrap');
        let visibleLimit = PAGE_SIZE;

        function applyFilters(resetPage = true) {
            if (resetPage) visibleLimit = PAGE_SIZE;
            const search = (searchInput?.value || '').toLowerCase().trim();
            const role = roleFilter?.value || '';
            const status = statusFilter?.value || '';
            const matchedRows = [];

            rows.forEach(row => {
                const rowRole = row.dataset.role || '';
                const rowStatus = row.dataset.status || '';
                const rowSearch = (row.dataset.search || '').toLowerCase();

                const matchesSearch = !search || rowSearch.includes(search);
                const matchesRole = !role || rowRole === role;
                const matchesStatus = !status || rowStatus === status;
                const isVisible = matchesSearch && matchesRole && matchesStatus;

                row.classList.toggle('d-none', !isVisible);
                if (isVisible) matchedRows.push(row);
            });

            const showEmpty = matchedRows.length === 0;
            if (noResults) noResults.classList.toggle('d-none', !showEmpty);
            if (tableWrap) tableWrap.classList.toggle('d-none', showEmpty);

            if (matchedRows.length === 0 || matchedRows.length <= PAGE_SIZE) {
                matchedRows.forEach(row => row.classList.remove('d-none'));
                if (paginationWrap) paginationWrap.classList.add('d-none');
                if (loadMoreBtn) loadMoreBtn.classList.add('d-none');
                if (loadLessBtn) loadLessBtn.classList.add('d-none');
                if (paginationInfo) paginationInfo.textContent = '';
                return;
            }

            if (visibleLimit > matchedRows.length) visibleLimit = matchedRows.length;
            const showUpTo = Math.min(visibleLimit, matchedRows.length);

            matchedRows.forEach((row, idx) => {
                row.classList.toggle('d-none', idx >= showUpTo);
            });

            if (paginationWrap) paginationWrap.classList.remove('d-none');

            const remaining = matchedRows.length - showUpTo;
            if (loadMoreBtn) {
                if (remaining > 0) {
                    loadMoreBtn.classList.remove('d-none');
                    const nextBatch = Math.min(remaining, PAGE_SIZE);
                    loadMoreBtn.textContent = `Показать ещё ${nextBatch}`;
                } else {
                    loadMoreBtn.classList.add('d-none');
                }
            }

            if (loadLessBtn) {
                const hideCount = showUpTo - Math.max(PAGE_SIZE, showUpTo - PAGE_SIZE);
                if (showUpTo > PAGE_SIZE && hideCount > 0) {
                    loadLessBtn.classList.remove('d-none');
                    loadLessBtn.textContent = hideCount < PAGE_SIZE ? `Свернуть (${hideCount})` : `Свернуть ${PAGE_SIZE}`;
                } else {
                    loadLessBtn.classList.add('d-none');
                }
            }

            if (paginationInfo) {
                paginationInfo.textContent = `Показано ${showUpTo} из ${matchedRows.length}`;
            }
        }

        document.querySelectorAll('.js-dismiss-alert').forEach(button => {
            button.addEventListener('click', function () {
                const alert = this.closest('.alert');
                if (alert) alert.remove();
            });
        });

        if (searchInput) searchInput.addEventListener('input', applyFilters);
        if (roleFilter) roleFilter.addEventListener('change', applyFilters);
        if (statusFilter) statusFilter.addEventListener('change', applyFilters);
        if (resetBtn) {
            resetBtn.addEventListener('click', function () {
                if (roleFilter) roleFilter.value = '';
                if (statusFilter) statusFilter.value = '';
                if (searchInput) searchInput.value = '';
                const headerSearch = document.getElementById('admin-header-search');
                if (headerSearch) headerSearch.value = '';
                applyFilters();
            });
        }

        if (loadMoreBtn) {
            loadMoreBtn.addEventListener('click', function () {
                visibleLimit += PAGE_SIZE;
                applyFilters(false);
            });
        }

        if (loadLessBtn) {
            loadLessBtn.addEventListener('click', function () {
                visibleLimit = Math.max(PAGE_SIZE, visibleLimit - PAGE_SIZE);
                applyFilters(false);
            });
        }

        applyFilters();
    })();
</script>
