@model Toolify.ProductService.Models.Product

@{
    ViewData["Title"] = "Редактировать товар";
    Layout = "_AdminLayout";
}

<link rel="stylesheet" href="~/css/create-product.css" asp-append-version="true" />

<div class="admin-flush-page" data-admin-heading="Редактировать товар">
    <div class="admin-form-wrapper">

        @if (TempData["AdminError"] is string adminErr && !string.IsNullOrEmpty(adminErr))
        {
            <div class="mb-3 p-3 rounded-2 border" style="background:#fde8e8;border-color:#e8b4b4 !important;color:#8a2a2a;">@adminErr</div>
        }

        <div asp-validation-summary="All" class="text-danger mb-3 small"></div>

        <form method="post" enctype="multipart/form-data" asp-action="Edit" class="admin-product-form">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ImagePath" />
            <input type="hidden" asp-for="ArticleNumber">
            <input type="hidden" asp-for="Discount" />

            <div class="category-box">
                <div class="form-group mb-0">
                    <p class="form-label-inline"><b>Категория</b></p>
                    <select asp-for="CategoryId" asp-items="ViewBag.Categories" required class="form-select form-select-admin">
                        <option value="0">— Выберите категорию —</option>
                    </select>
                </div>
            </div>

            <div class="admin-product-form-grid">
                <div class="admin-product-form-col admin-product-form-col--main">
                    <div class="form-group">
                        <p class="form-label-inline"><b>Название</b></p>
                        <input type="text" asp-for="Name" required class="form-input" />
                    </div>

                    <div class="form-group">
                        <p class="form-label-inline"><b>Краткое описание</b></p>
                        <input type="text" asp-for="ShortDescription" class="form-input" required />
                    </div>

                    <div class="form-group">
                        <p class="form-label-inline"><b>Полное описание</b></p>
                        <textarea asp-for="FullDescription" rows="3" class="form-textarea form-textarea-compact" required></textarea>
                    </div>
                </div>

                <aside class="admin-product-form-col admin-product-form-col--meta">
                    <div class="form-group mb-0">
                        <p class="form-label-inline"><b>Цена (<span class="nbrb-icon">&#xE901;</span>)</b></p>
                        <input type="number" asp-for="Price" step="0.01" min="0.01" required class="form-input" />
                    </div>
                    <div class="form-group">
                        <p class="form-label-inline"><b>На складе, шт.</b></p>
                        <input type="number" asp-for="StockQuantity" min="1" required class="form-input" />
                    </div>
                    <div class="form-group mb-0">
                        <p class="form-label-inline"><b>Текущее изображение</b></p>
                        <div class="admin-product-image-preview">
                            <img src="https://localhost:7188/api/Product/@(Model.Id)/image"
                                 width="150"
                                 style="max-width: 100%; height: auto;"
                                 alt=""
                                 onerror="this.onerror=null; this.src='/images/no-image.png';" />
                        </div>
                    </div>
                    <div class="form-group mb-0">
                        <p class="form-label-inline"><b>Загрузить новое</b> <span class="text-muted fw-normal small">(если нужно)</span></p>
                        <input type="file" name="image" class="form-input form-input-file" accept="image/*" />
                    </div>
                </aside>
            </div>

            <div id="features-section" class="features-section">
                <h3 class="features-section-title">Характеристики товара</h3>

                <div id="features-container">
                    @if (Model.Configurations != null && Model.Configurations.Any())
                    {
                        for (int i = 0; i < Model.Configurations.Count; i++)
                        {
                            var config = Model.Configurations[i];
                            <div class="feature-row">
                                <div class="feature-row-fields">
                                    <label class="feature-label">@config.FeatureName</label>
                                    <input type="hidden" name="Configurations[@i].FeatureId" value="@config.FeatureId" />
                                    <input type="hidden" name="Configurations[@i].FeatureName" value="@config.FeatureName" />
                                    <input type="text" name="Configurations[@i].FeatureValue" value="@config.FeatureValue" class="form-input" />
                                </div>
                                <button type="button" onclick="removeFeature(this)" class="btn btn-outline-danger btn-sm align-self-end">✕</button>
                            </div>
                        }
                    }
                </div>

                <button type="button" onclick="addCustomFeature()" class="btn btn-outline-primary btn-sm mt-2">
                    + Добавить своё поле
                </button>
            </div>

            <div class="form-actions form-actions--sticky">
                <button type="submit" class="btn btn-primary">Сохранить изменения</button>
                <a href="/Admin/List" class="btn btn-cancel">Отмена</a>
            </div>
        </form>
    </div>
</div>

<script>
    function reindexFeatureRows() {
        const container = document.getElementById('features-container');
        const rows = container.querySelectorAll('.feature-row');
        rows.forEach((row, index) => {
            row.querySelectorAll('input').forEach(input => {
                const name = input.getAttribute('name');
                if (name) {
                    input.setAttribute('name', name.replace(/Configurations\[\d+\]/, `Configurations[${index}]`));
                }
            });
        });
    }

    function removeFeature(btn) {
        const row = btn.closest('.feature-row');
        row.remove();
        reindexFeatureRows();
    }

    function addCustomFeature() {
        const container = document.getElementById('features-container');
        const index = container.querySelectorAll('.feature-row').length;

        const div = document.createElement('div');
        div.className = 'feature-row';

        div.innerHTML = `
            <div class="feature-row-fields feature-row-fields--split">
                <div>
                    <label class="feature-label small text-muted">Название</label>
                    <input type="text" placeholder="Напр. Вес" name="Configurations[${index}].FeatureName" class="form-input" required />
                </div>
                <div>
                    <label class="feature-label small text-muted">Значение</label>
                    <input type="text" placeholder="Значение" name="Configurations[${index}].FeatureValue" class="form-input" required />
                </div>
                <input type="hidden" name="Configurations[${index}].FeatureId" value="0" />
            </div>
            <button type="button" onclick="removeFeature(this)" class="btn btn-outline-danger btn-sm align-self-end">✕</button>
        `;
        container.appendChild(div);
    }
</script>
