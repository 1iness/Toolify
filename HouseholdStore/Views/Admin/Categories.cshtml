@model List<Toolify.ProductService.Models.CategoryAdminItem>
@{
    ViewData["Title"] = "Категории";
    Layout = "_AdminLayout";
    var featuresByCategory = ViewBag.CategoryFeatures as Dictionary<int, List<Toolify.ProductService.Models.ProductFeature>>
                             ?? new Dictionary<int, List<Toolify.ProductService.Models.ProductFeature>>();
}
<link rel="stylesheet" href="~/css/site.css" />

<div class="admin-flush-page" data-admin-heading="Категории">
    <h1 class="visually-hidden">Категории</h1>
    @if (TempData["CategoryMessage"] != null)
    {
        <p class="text-success mb-2">@TempData["CategoryMessage"]</p>
    }
    @if (TempData["CategoryError"] != null)
    {
        <p class="text-danger mb-2">@TempData["CategoryError"]</p>
    }
    <div class="admin-products-list-toolbar">
        <div class="admin-products-list-actions">
            <a href="/Admin/Create" class="btn-create">Добавить товар</a>
            <a href="/Admin/List" class="btn-create btn-create--secondary">К списку товаров</a>
        </div>
    </div>

    <div class="category-create-card">
        <h2 class="category-create-card__title">Создать категорию</h2>
        <form asp-action="CreateCategory" method="post" class="category-create-form">
            @Html.AntiForgeryToken()
            <div class="category-create-grid">
                <div>
                    <label class="form-label fw-semibold">Название категории</label>
                    <input type="text" name="name" class="form-control" placeholder="Например: Смартфоны" maxlength="120" required />
                </div>
                <div>
                    <label class="form-label fw-semibold">Характеристики категории</label>
                    <div id="categoryFeatureRows" class="category-feature-rows">
                        <div class="category-feature-row">
                            <input type="text" name="featureNames" class="form-control" placeholder="Например: Бренд" maxlength="100" />
                            <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeCategoryFeatureRow(this)">Удалить</button>
                        </div>
                    </div>
                    <button type="button" class="btn btn-outline-primary btn-sm mt-2" onclick="addCategoryFeatureRow()">+ Добавить характеристику</button>
                </div>
            </div>
            <button type="submit" class="btn-create mt-3">Создать категорию</button>
        </form>
    </div>

    <div class="admin-products-table-wrap">
    <table class="admin-table admin-table--products">
        <thead>
            <tr>
                <th>Название</th>
                <th>Статус</th>
                <th>Характеристики</th>
                <th>Товаров</th>
                <th>Иконка</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody id="categories-filter-tbody">
        @if (Model != null && Model.Count > 0)
        {
            foreach (var c in Model)
            {
                featuresByCategory.TryGetValue(c.Id, out var features);
                features ??= new List<Toolify.ProductService.Models.ProductFeature>();

                var nameNorm = (c.Name ?? "").Trim().ToLowerInvariant();
                var searchParts = new List<string> { nameNorm };
                foreach (var f in features)
                {
                    var fn = (f.Name ?? "").Trim();
                    if (!string.IsNullOrEmpty(fn))
                        searchParts.Add(fn.ToLowerInvariant());
                }
                var categorySearchBlob = string.Join(' ', searchParts).Trim();

                <tr data-category-search="@categorySearchBlob">
                    <td><strong>@c.Name</strong></td>
                    <td>
                        @if (c.IsHiddenFromCatalog)
                        {
                            <span class="badge bg-secondary">Скрыта</span>
                        }
                        else
                        {
                            <span class="badge bg-success">На витрине</span>
                        }
                    </td>
                    <td>
                        @if (features.Count > 0)
                        {
                            <div class="category-feature-badges">
                                @foreach (var f in features)
                                {
                                    <span class="category-feature-badge">@f.Name</span>
                                }
                            </div>
                        }
                        else
                        {
                            <span style="color:#999;">—</span>
                        }
                    </td>
                    <td>@c.ProductCount</td>
                    <td style="min-width: 200px; vertical-align: top;">
                        @if (!string.IsNullOrEmpty(c.IconFileName))
                        {
                            <div><img src="~/image/category-icons/@c.IconFileName" alt="" style="max-height: 44px; object-fit: contain;" /></div>
                        }
                        else
                        {
                            <span style="color:#999;">—</span>
                        }
                        <form asp-action="UploadCategoryIcon" method="post" enctype="multipart/form-data" style="margin-top:8px;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@c.Id" />
                            <input type="file" name="iconFile" accept=".png,.jpg,.jpeg,.webp,.gif" style="max-width: 180px; font-size: 12px;" />
                            <button type="submit" class="btn-create" style="font-size: 12px; padding: 4px 10px; margin-top: 4px;">Сохранить</button>
                        </form>
                    </td>
                    <td>
                        <form asp-action="SetCategoryCatalogVisibility"
                              method="post"
                              style="display:inline;"
                              onsubmit="return confirm('@(c.IsHiddenFromCatalog ? "Показать категорию в каталоге? Товары, скрытые отдельно, останутся скрытыми." : "Скрыть категорию и все её товары из каталога?")');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@c.Id" />
                            <input type="hidden" name="isHiddenFromCatalog" value="@(c.IsHiddenFromCatalog ? "false" : "true")" />
                            <button type="submit" class="btn btn-link p-0 align-baseline">
                                @(c.IsHiddenFromCatalog ? "Показать" : "Скрыть")
                            </button>
                        </form>
                        @if (c.ProductCount == 0)
                        {
                            <text> | </text>
                            <form asp-action="DeleteCategory" method="post" style="display:inline;" onsubmit="return confirm('Удалить эту категорию?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@c.Id" />
                                <button type="submit" class="delete-link" style="border:none;background:none;cursor:pointer;padding:0;color:#c00;text-decoration:underline;">Удалить</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr class="categories-empty-row"><td colspan="6">Категорий нет.</td></tr>
        }
        </tbody>
    </table>
    </div>

    <div id="categories-pagination-wrap" class="categories-load-more-wrap mt-3 d-none text-center">
        <div class="d-flex flex-wrap gap-2 justify-content-center mb-2">
            <button type="button" class="btn-create categories-load-action-btn d-none" id="categories-load-more-btn">Показать ещё</button>
            <button type="button" class="btn-create btn-create--secondary categories-load-action-btn d-none" id="categories-load-less-btn">Свернуть</button>
        </div>
        <p class="text-muted small mb-0" id="categories-pagination-info"></p>
    </div>
</div>

<script>
    function addCategoryFeatureRow() {
        const container = document.getElementById('categoryFeatureRows');
        if (!container) return;

        const row = document.createElement('div');
        row.className = 'category-feature-row';
        row.innerHTML = `
            <input type="text" name="featureNames" class="form-control" placeholder="Например: Материал" maxlength="100" />
            <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeCategoryFeatureRow(this)">Удалить</button>
        `;
        container.appendChild(row);
    }

    function removeCategoryFeatureRow(button) {
        const row = button.closest('.category-feature-row');
        const container = document.getElementById('categoryFeatureRows');
        if (!row || !container) return;
        if (container.children.length <= 1) {
            row.querySelector('input').value = '';
            return;
        }
        row.remove();
    }
</script>
