@model IEnumerable<Toolify.ProductService.Models.PromoCode>

@{
    ViewData["Title"] = "Управление промокодами";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-2 promo-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row">

        <div class="col-lg-4 mb-4">
            <div class="card promo-card">
                <div class="promo-card-header">
                    <h6 class="promo-card-title">Создать новый промокод</h6>
                </div>
                <div class="card-body">
                    <form asp-action="CreatePromoCode" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Код</label>
                            <input type="text" name="Code" class="form-control input-promo-code" placeholder="Например: NEWYEAR" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Скидка (%)</label>
                            <input type="number" name="DiscountPercent" class="form-control" min="1" max="100" placeholder="От 1 до 100" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Начало действия</label>
                            <input type="datetime-local" name="StartDate" id="startDate" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Конец действия</label>
                            <input type="datetime-local" name="EndDate" id="endDate" class="form-control" required />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Лимит использований</label>
                            <input type="number" name="maxUses" class="form-control" min="1" max="999999999" step="1" placeholder="Необязательно" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Мин. сумма товаров</label>
                            <input type="number" name="minGoodsAmount" class="form-control" min="0" step="0.01" placeholder="Необязательно" />
                        </div>
                        <div class="form-check mb-4">
                            <input class="form-check-input" type="checkbox" name="sendNotification" value="true" checked id="promoSendNotification" />
                            <input type="hidden" name="sendNotification" value="false" />
                            <label class="form-check-label" for="promoSendNotification">Отправить рассылку пользователям</label>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 fw-bold">Добавить промокод</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card promo-card">
                <div class="promo-card-header">
                    <h6 class="promo-card-title">Список промокодов</h6>
                </div>
                <div class="px-3 pt-3">
                    <label class="form-label small text-muted mb-1" for="promo-code-status-filter">Показать</label>
                    <select id="promo-code-status-filter" class="form-select form-select-sm" style="max-width: 240px;">
                        <option value="all">Все промокоды</option>
                        <option value="active">Только активированные</option>
                        <option value="inactive">Только деактивированные</option>
                    </select>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover promo-table mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th>Код</th>
                                    <th>Скидка</th>
                                    <th>Срок действия</th>
                                    <th>Использования</th>
                                    <th>Статус</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var promo in Model)
                                    {
                                        var isActive = promo.IsValid;
                                        <tr data-promo-code-row
                                            data-promo-code-status="@(promo.IsActive ? "active" : "inactive")"
                                            data-promo-code-search="@($"{promo.Code} {promo.DiscountPercent} {promo.DiscountPercent}% {(promo.IsActive ? "активен активированный" : "отключен деактивирован")}".ToLowerInvariant())">
                                            <td class="fw-bold text-dark">@promo.Code</td>
                                            <td><span class="badge bg-success" style="font-size: 0.9em;">-@promo.DiscountPercent%</span></td>
                                            <td class="text-muted" style="font-size: 0.85rem;">
                                                @promo.StartDate.ToString("dd.MM.yyyy HH:mm") <br />
                                                <i class="fas fa-long-arrow-alt-down"></i> <br />
                                                @promo.EndDate.ToString("dd.MM.yyyy HH:mm")
                                            </td>
                                            <td class="text-muted" style="font-size: 0.85rem;">
                                                @if (promo.MaxUses.HasValue)
                                                {
                                                    <span>@promo.UsedCount / @promo.MaxUses.Value</span>
                                                }
                                                else
                                                {
                                                    <span>—</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!promo.IsActive)
                                                {
                                                    <span class="promo-badge promo-badge-expired"><i class="fas fa-pause-circle"></i> Отключён</span>
                                                }
                                                else if (isActive)
                                                {
                                                    <span class="promo-badge promo-badge-active"><i class="fas fa-check-circle"></i> Активен</span>
                                                }
                                                else
                                                {
                                                    <span class="promo-badge promo-badge-expired"><i class="fas fa-times-circle"></i> Недоступен</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="d-flex flex-wrap gap-2">
                                                    <form asp-action="SetPromoCodeActive" method="post" class="m-0">
                                                        <input type="hidden" name="id" value="@promo.Id" />
                                                        <input type="hidden" name="isActive" value="@(!promo.IsActive ? "true" : "false")" />
                                                        <button type="submit" class="btn btn-outline-secondary btn-sm">
                                                            @(promo.IsActive ? "Деактивировать" : "Активировать")
                                                        </button>
                                                    </form>
                                                    <form asp-action="DeletePromoCode"
                                                          method="post"
                                                          class="m-0"
                                                          onsubmit="return confirm('Удалить промокод «@promo.Code»? Если он уже использовался в заказах, удаление может быть недоступно.');">
                                                        <input type="hidden" name="id" value="@promo.Id" />
                                                        <button type="submit" class="btn btn-outline-danger btn-sm">Удалить</button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr class="promo-codes-empty-row">
                                        <td colspan="6" class="text-center text-muted py-5">
                                            <i class="fas fa-ticket-alt fa-3x mb-3 text-light"></i><br />
                                            Промокоды пока не созданы
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div id="promo-codes-pagination-wrap" class="products-load-more-wrap p-3 d-none text-center">
                        <div class="d-flex flex-wrap gap-2 justify-content-center mb-2">
                            <button type="button" class="btn-create categories-load-action-btn d-none" id="promo-codes-load-more-btn">Показать ещё</button>
                            <button type="button" class="btn-create btn-create--secondary categories-load-action-btn d-none" id="promo-codes-load-less-btn">Свернуть</button>
                        </div>
                        <p class="text-muted small mb-0" id="promo-codes-pagination-info"></p>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const now = new Date();
        const offset = now.getTimezoneOffset() * 60000;

        const localISOTime = (new Date(now - offset)).toISOString().slice(0, 16);
        document.getElementById('startDate').value = localISOTime;

        const nextMonth = new Date(now.setMonth(now.getMonth() + 1));
        const nextMonthISO = (new Date(nextMonth - offset)).toISOString().slice(0, 16);
        document.getElementById('endDate').value = nextMonthISO;
    });
</script>