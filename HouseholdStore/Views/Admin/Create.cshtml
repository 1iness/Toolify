@model Toolify.ProductService.Models.Product

@{
    ViewData["Title"] = "Добавить товар";
    Layout = "_AdminLayout";
}

<link rel="stylesheet" href="~/css/create-product.css" asp-append-version="true" />

<div class="admin-flush-page" data-admin-heading="Добавить товар">
    <h1 class="visually-hidden">Добавить товар</h1>

    <div class="admin-form-wrapper">

        <div asp-validation-summary="All" class="text-danger mb-3 small"></div>

        <form method="post" enctype="multipart/form-data" asp-action="Create" class="admin-product-form">

            <div class="category-box">
                <div class="category-box-inner">
                    <div class="form-group mb-0">
                        <p class="form-label-inline"><b>Категория</b></p>
                        <select name="CategoryId" asp-items="ViewBag.Categories" class="form-select form-select-admin">
                            <option value="0">— Выберите из списка —</option>
                        </select>
                    </div>
                    <div class="form-group mb-0">
                        <p class="form-label-inline"><b>Новая категория</b> <span class="text-muted fw-normal small">(если не из списка)</span></p>
                        <input type="text" name="NewCategoryName" placeholder="Название" class="form-input" />
                    </div>
                </div>
            </div>

            <div class="admin-product-form-grid">
                <div class="admin-product-form-col admin-product-form-col--main">
                    <div class="form-group">
                        <p class="form-label-inline"><b>Название</b></p>
                        <input type="text" name="Name" value="@Model?.Name" class="form-input" required />
                    </div>

                    <div class="form-group">
                        <p class="form-label-inline"><b>Краткое описание</b></p>
                        <input type="text" name="ShortDescription" value="@Model?.ShortDescription" class="form-input" required />
                    </div>

                    <div class="form-group">
                        <p class="form-label-inline"><b>Полное описание</b></p>
                        <textarea name="FullDescription" rows="3" class="form-textarea form-textarea-compact" required>@Model?.FullDescription</textarea>
                    </div>
                </div>

                <aside class="admin-product-form-col admin-product-form-col--meta">
                    <div class="form-group mb-0">
                        <p class="form-label-inline"><b>Цена (<span class="nbrb-icon">&#xE901;</span>)</b></p>
                        <input type="number" name="Price" value="@Model?.Price" step="0.01" min="0.01" class="form-input" required />
                    </div>
                    <div class="form-group">
                        <p class="form-label-inline"><b>На складе, шт.</b></p>
                        <input type="number" name="StockQuantity" value="@(Model?.StockQuantity > 0 ? Model.StockQuantity : 1)" min="1" class="form-input" required />
                    </div>
                    <div class="form-group mb-0">
                        <p class="form-label-inline"><b>Изображение</b></p>
                        <input type="file" name="image" class="form-input form-input-file" accept="image/*" required />
                    </div>
                </aside>
            </div>

            <div id="features-section" class="features-section" style="display:none;">
                <h3 class="features-section-title">Характеристики категории</h3>
                <div id="features-container">
                    @if (Model?.Configurations != null && Model.Configurations.Any())
                    {
                        for (int i = 0; i < Model.Configurations.Count; i++)
                        {
                            var config = Model.Configurations[i];
                            <div class="feature-row">
                                <div class="feature-row-fields">
                                    <label class="feature-label">@config.FeatureName</label>
                                    <input type="hidden" name="Configurations[@i].FeatureId" value="@config.FeatureId" />
                                    <input type="hidden" name="Configurations[@i].FeatureName" value="@config.FeatureName" />
                                    <input type="text" name="Configurations[@i].FeatureValue" value="@config.FeatureValue" class="form-input" />
                                </div>
                                <button type="button" onclick="removeFeature(this)" class="btn btn-outline-danger btn-sm align-self-end">✕</button>
                            </div>
                        }
                    }
                </div>

                <button type="button" onclick="addCustomFeature()" class="btn btn-outline-primary btn-sm mt-2">
                    + Добавить своё поле
                </button>
            </div>

            <div id="custom-features-container"></div>

            <div class="form-actions form-actions--sticky">
                <button type="submit" class="btn btn-primary">Добавить</button>
                <a href="/Admin/List" class="btn btn-cancel">Отмена</a>
            </div>
        </form>
    </div>
</div>

<script>
    document.querySelector('select[name="CategoryId"]').addEventListener('change', async function () {
        const categoryId = this.value;
        const container = document.getElementById('features-container');
        const section = document.getElementById('features-section');
        container.innerHTML = '';

        if (!categoryId) {
            container.innerHTML = '';
            section.style.display = 'none';
            return;
        }

        try {
            const response = await fetch(`/Admin/GetFeatures?categoryId=${categoryId}`);
            const data = await response.json();

            section.style.display = 'block';
            container.innerHTML = '';

            if (data && data.length > 0) {
                data.forEach((feature, index) => {
                    const div = document.createElement('div');
                    div.className = 'feature-row';
                    div.innerHTML = `
                        <div class="feature-row-fields feature-row-fields--split">
                            <div>
                                <label class="feature-label small text-muted">Характеристика</label>
                                <input type="text" name="Configurations[${index}].FeatureName" value="${feature.name}" readonly class="form-input form-input-readonly" />
                            </div>
                            <div>
                                <label class="feature-label small text-muted">Значение</label>
                                <input type="text" name="Configurations[${index}].FeatureValue" placeholder="Введите значение…" required class="form-input" />
                            </div>
                            <input type="hidden" name="Configurations[${index}].FeatureId" value="${feature.id}" />
                        </div>
                        <button type="button" onclick="removeFeature(this)" class="btn btn-outline-danger btn-sm align-self-end">✕</button>
                    `;
                    container.appendChild(div);
                });
            }
        } catch (error) {
            console.error('Ошибка:', error);
        }
    });

    function addCustomFeature() {
        const container = document.getElementById('features-container');
        const section = document.getElementById('features-section');
        section.style.display = 'block';

        const div = document.createElement('div');
        div.className = 'feature-row';
        div.innerHTML = `
            <div class="feature-row-fields feature-row-fields--split">
                <div>
                    <input type="text" placeholder="Название (напр. Вес)" name="Configurations[X].FeatureName" required class="form-input" />
                </div>
                <div>
                    <input type="text" placeholder="Значение" name="Configurations[X].FeatureValue" required class="form-input" />
                </div>
                <input type="hidden" name="Configurations[X].FeatureId" value="0" />
            </div>
            <button type="button" onclick="removeFeature(this)" class="btn btn-outline-danger btn-sm">✕</button>
        `;
        container.appendChild(div);
        reindexFeatures();
    }

    function removeFeature(btn) {
        const row = btn.closest('.feature-row');
        row.remove();
        reindexFeatures();

        const container = document.getElementById('features-container');
        if (container.children.length === 0) {
            document.getElementById('features-section').style.display = 'none';
        }
    }

    function reindexFeatures() {
        const container = document.getElementById('features-container');
        const rows = container.getElementsByClassName('feature-row');

        for (let i = 0; i < rows.length; i++) {
            const inputs = rows[i].querySelectorAll('input');
            inputs.forEach(input => {
                const name = input.getAttribute('name');
                if (name) {
                    input.setAttribute('name', name.replace(/Configurations\[(?:\d+|X)\]/, `Configurations[${i}]`));
                }
            });
        }
    }
</script>
